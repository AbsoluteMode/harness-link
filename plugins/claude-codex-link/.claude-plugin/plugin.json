{
  "name": "codex-claude-link",
  "version": "0.10.0",
  "description": "Consult Claude and exchange messages across Claude Code, Codex, and Gemini 4 Carbon.",
  "author": {
    "name": "max"
  },
  "license": "MIT",
  "mcpServers": {
    "claude-codex-link": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/server.mjs"
      ],
      "env": {
        "HARNESS_LINK_ROOM_ROLE": "claude"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/inbox-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/inbox-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/inbox-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
